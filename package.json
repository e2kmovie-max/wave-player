{
  "name": "wave-player",
  "private": true,
  "version": "0.1.0",
  "description": "Wave player service: source preview, room creation, stream proxying and Go streaming instance.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun build packages/player/src/index.ts --target bun --outdir dist/player",
    "lint": "bun --filter \"*\" lint",
    "typecheck": "bun --filter \"*\" typecheck",
    "test": "bun test packages/shared/test",
    "go:vet": "cd apps/instance && go vet ./...",
    "go:test": "cd apps/instance && go test ./..."
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.3"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "packageManager": "bun@1.3.13"
}
